# ft_transcendence — local environment template.
# Copy to .env and fill in the values marked GENERATE.
#   cp .env.example .env
# Never commit .env; it is gitignored.

# ---------------------------------------------------------------------------
# Compose / PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=auth
# GENERATE a password:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=auth

# Host port the gateway publishes HTTPS on (443 needs no :port in the browser).
HTTPS_PORT=443

# ---------------------------------------------------------------------------
# auth-service
# ---------------------------------------------------------------------------
# production keeps logs structured (JSON) for the ELK pipeline (Phase 3).
APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=info

# GENERATE the JWT signing key:  openssl rand -base64 32
JWT_SECRET=

ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=720h

# ---------------------------------------------------------------------------
# Monitoring (issues #73–79)
# ---------------------------------------------------------------------------
# Grafana administrator (issue #78): never leave the image default password.
GRAFANA_ADMIN_USER=admin
# GENERATE a password:  openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=

# nginx basic auth for the Prometheus UI (the UI itself has no login).
PROMETHEUS_USER=prom
# GENERATE a password:  openssl rand -base64 16
PROMETHEUS_PASSWORD=

# ---------------------------------------------------------------------------
# ELK logging stack (issues #56–63)
# ---------------------------------------------------------------------------
# Elasticsearch superuser — used by the one-shot setup jobs and emergency
# access; services run on dedicated low-privilege users.
# GENERATE a password:  openssl rand -base64 24
ELASTIC_PASSWORD=

# GENERATE a password:  openssl rand -base64 24
LOGSTASH_PASSWORD=

# GENERATE a password:  openssl rand -base64 24
KIBANA_SYSTEM_PASSWORD=