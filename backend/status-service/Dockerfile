# Build with the backend directory as context so the shared module is available:
#   docker build -f status-service/Dockerfile .   (run from backend/)
FROM golang:1.27.1 AS build

WORKDIR /src
COPY shared ./shared
COPY status-service ./status-service

WORKDIR /src/status-service
RUN CGO_ENABLED=0 go build -trimpath -o /out/status-service ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /out/status-service /status-service

EXPOSE 8080
ENTRYPOINT ["/status-service"]